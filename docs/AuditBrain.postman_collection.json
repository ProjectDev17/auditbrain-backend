{
  "info": {
    "_postman_id": "auditbrain-collection-v2",
    "name": "AuditBrain API - Fase 2",
    "description": "Colección completa para la API de AuditBrain con filtros, ordenamiento, eventos y evidencias.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Audits",
      "item": [
        {
          "name": "List Audits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", ""]
            }
          }
        },
        {
          "name": "List Audits (Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/?status=pending&ordering=-created_at",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", ""],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "ordering", "value": "-created_at" }
              ]
            }
          }
        },
        {
          "name": "List Audits (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/?page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Audit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Auditoría de Seguridad 2024\",\n  \"description\": \"Revisión semestral de accesos.\",\n  \"status\": \"pending\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/audits/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", ""]
            }
          }
        },
        {
          "name": "Get Audit Detail (Extended)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/{{audit_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", "{{audit_id}}", ""]
            }
          }
        },
        {
          "name": "Update Audit",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"description\": \"Iniciado el proceso de revisión.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/audits/{{audit_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", "{{audit_id}}", ""]
            }
          }
        },
        {
          "name": "Delete Audit (Soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/{{audit_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", "{{audit_id}}", ""]
            }
          }
        }
      ]
    },

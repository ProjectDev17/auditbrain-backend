{
  "info": {
    "_postman_id": "auditbrain-collection-v2",
    "name": "AuditBrain API - Fase 2",
    "description": "Colección completa para la API de AuditBrain con filtros, ordenamiento, eventos y evidencias.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Obtain Token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Obtener tokens de acceso y refresh mediante email y contraseña"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            },
            "description": "Renovar el token de acceso usando el refresh token"
          }
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{access_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/token/verify/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "token", "verify", ""]
            },
            "description": "Verificar si un token es válido"
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"password_confirm\": \"SecurePass123!\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Registrar un nuevo usuario en el sistema"
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile", ""]
            },
            "description": "Obtener información del perfil del usuario autenticado"
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Smith\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/profile/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile", ""]
            },
            "description": "Actualizar información del perfil del usuario"
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/password/reset/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "password", "reset", ""]
            },
            "description": "Solicitar recuperación de contraseña por email"
          }
        },
        {
          "name": "Confirm Password Reset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"reset_token_from_email\",\n  \"new_password\": \"NewSecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/password/reset/confirm/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "password", "reset", "confirm", ""]
            },
            "description": "Confirmar nueva contraseña con el token recibido por email"
          }
        }
      ]
    },
    {
      "name": "Audits",
      "item": [
        {
          "name": "List Audits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", ""]
            }
          }
        },
        {
          "name": "List Audits (Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/?status=pending&ordering=-created_at",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", ""],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "ordering", "value": "-created_at" }
              ]
            }
          }
        },
        {
          "name": "List Audits (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/?page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Audit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Auditoría de Seguridad 2024\",\n  \"description\": \"Revisión semestral de accesos.\",\n  \"status\": \"pending\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/audits/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", ""]
            }
          }
        },
        {
          "name": "Get Audit Detail (Extended)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/{{audit_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", "{{audit_id}}", ""]
            }
          }
        },
        {
          "name": "Update Audit",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"description\": \"Iniciado el proceso de revisión.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/audits/{{audit_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", "{{audit_id}}", ""]
            }
          }
        },
        {
          "name": "Delete Audit (Soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audits/{{audit_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "audits", "{{audit_id}}", ""]
            }
          }
        }
      ]
    },

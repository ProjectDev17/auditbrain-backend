    {
      "name": "Reports",
      "item": [
        {
          "name": "Audit Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/reports/audits/summary/",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "audits", "summary", ""]
            },
            "description": "Resumen general de auditorías: totales, por estado, activas vs eliminadas"
          }
        },
        {
          "name": "Audits by Period",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/reports/audits/by-period/?grouping=monthly",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "audits", "by-period", ""],
              "query": [
                {
                  "key": "start_date",
                  "value": "2025-01-01T00:00:00Z",
                  "disabled": true
                },
                {
                  "key": "end_date",
                  "value": "2025-12-31T23:59:59Z",
                  "disabled": true
                },
                { "key": "grouping", "value": "monthly" }
              ]
            },
            "description": "Auditorías agrupadas por período (daily, weekly, monthly). Datos listos para gráficos."
          }
        },
